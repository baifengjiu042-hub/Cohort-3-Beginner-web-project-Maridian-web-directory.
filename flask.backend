"""
Meridian by Sofia | Python (Flask) backend

How to run:
    pip install flask
    python app.py
Then open  http://127.0.0.1:5000  in your browser.

What this file does:
  - serves the website (index.html, style.css, app.js)
  - stores user accounts in a SQLite database file (meridian.db)
  - hashes passwords (they are never saved as plain text)
  - keeps people logged in with a secure session cookie (1 year)
"""
import os
import re
import secrets
import sqlite3
from datetime import timedelta

from flask import Flask, jsonify, request, send_from_directory, session
from werkzeug.security import check_password_hash, generate_password_hash

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE_DIR, "meridian.db")
KEY_PATH = os.path.join(BASE_DIR, "secret.key")
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def load_secret_key():
    """Create a random secret key the first time, then reuse it."""
    if not os.path.exists(KEY_PATH):
        with open(KEY_PATH, "w") as f:
            f.write(secrets.token_hex(32))
    with open(KEY_PATH) as f:
        return f.read().strip()


app = Flask(__name__)
app.secret_key = load_secret_key()
app.permanent_session_lifetime = timedelta(days=365)
app.config.update(
    SESSION_COOKIE_HTTPONLY=True,
    SESSION_COOKIE_SAMESITE="Lax",
    SEND_FILE_MAX_AGE_DEFAULT=0,   # always load the newest files while developing
)


# ---------- database ----------
def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_db()
    conn.execute(
        """CREATE TABLE IF NOT EXISTS users (
               id INTEGER PRIMARY KEY AUTOINCREMENT,
               name TEXT NOT NULL,
               email TEXT NOT NULL UNIQUE,
               password_hash TEXT NOT NULL,
               created_at TEXT DEFAULT CURRENT_TIMESTAMP)"""
    )
    # A ready-made demo account so a teacher can log in straight away
    if conn.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        conn.execute(
            "INSERT INTO users (name, email, password_hash) VALUES (?, ?, ?)",
            ("Demo User", "demo@example.com", generate_password_hash("demo123")),
        )
    conn.commit()
    conn.close()


def fail(message, code=400):
    return jsonify(ok=False, error=message), code


# ---------- API ----------
@app.post("/api/signup")
def signup():
    data = request.get_json(silent=True) or {}
    name = str(data.get("name", "")).strip()[:60]
    email = str(data.get("email", "")).strip().lower()[:254]
    password = str(data.get("password", ""))

    if not name:
        return fail("Please enter your name so we can greet you.")
    if not EMAIL_RE.match(email):
        return fail("Please enter a valid email, like name@example.com.")
    if not 6 <= len(password) <= 128:
        return fail("Your password needs at least 6 characters.")

    conn = get_db()
    try:
        cur = conn.execute(
            "INSERT INTO users (name, email, password_hash) VALUES (?, ?, ?)",
            (name, email, generate_password_hash(password)),
        )
        conn.commit()
        user_id = cur.lastrowid
    except sqlite3.IntegrityError:
        return fail("This email already has an account. Try logging in.", 409)
    finally:
        conn.close()

    session.permanent = True
    session["user_id"] = user_id
    return jsonify(ok=True, user={"name": name, "email": email}), 201


@app.post("/api/login")
def login():
    data = request.get_json(silent=True) or {}
    email = str(data.get("email", "")).strip().lower()
    password = str(data.get("password", ""))

    conn = get_db()
    row = conn.execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone()
    conn.close()

    if row is None or not check_password_hash(row["password_hash"], password):
        return fail("Email or password is incorrect. Check them or create an account.", 401)

    session.permanent = True
    session["user_id"] = row["id"]
    return jsonify(ok=True, user={"name": row["name"], "email": row["email"]})


@app.get("/api/me")
def me():
    """Tells the page who is logged in (this is how the login is remembered)."""
    user_id = session.get("user_id")
    if user_id is None:
        return jsonify(user=None)
    conn = get_db()
    row = conn.execute("SELECT name, email FROM users WHERE id = ?", (user_id,)).fetchone()
    conn.close()
    if row is None:
        session.clear()
        return jsonify(user=None)
    return jsonify(user={"name": row["name"], "email": row["email"]})


@app.post("/api/logout")
def logout():
    session.clear()
    return jsonify(ok=True)


# ---------- website files ----------
@app.get("/")
def home():
    return send_from_directory(BASE_DIR, "index.html")


@app.get("/<path:filename>")
def site_files(filename):
    if filename in ("app.js", "style.css"):      # only these files are public
        return send_from_directory(BASE_DIR, filename)
    return fail("Not found.", 404)


init_db()

if __name__ == "__main__":
    print("\nMeridian is running: open http://127.0.0.1:5000")
    print("Demo login:  demo@example.com  /  demo123\n")
    app.run(debug=True)